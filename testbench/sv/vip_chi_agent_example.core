    file_type: systemVerilogSource
    depend:
      - "akerlund::vip_chi_agent:1.0.0"
      - "akerlund::vip_report_server:0"

targets:
  default:
    toplevel: chi_tb_top
    filesets:
      - tb
    tools:
      vcs:
        vcs_options:
          - -ntb_opts
          - uvm-1.2
          # Queue for a licence instead of failing when the pool is busy.
          # Over-subscribing does not block: the run exits immediately with
          # "Licensed number of users already reached" and a `-` simtime, which
          # is indistinguishable from a real regression failure at a glance.
          # Built in rather than left as a command-line flag, because an escape
          # hatch you have to remember is one you remember after the confusing
          # result, not before it. (.refuse.yml keeps the VCS job counts at 2
          # for the same pool; queueing is only cheap when the queue is short.)
          - -licqueue
