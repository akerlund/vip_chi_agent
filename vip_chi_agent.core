      - sv/seq_lib/vip_chi_raw_seq.sv:            {is_include_file: true}
      - sv/vip_chi_agent.sv:                      {is_include_file: true}
      - sv/vip_chi_agent_e.sv:                    {is_include_file: true}
      - sv/vip_chi_hni_agent.sv:                  {is_include_file: true}
      - sv/vip_chi_hnf_agent.sv:                  {is_include_file: true}
      - sv/vip_chi_hnf_agent_e.sv:                {is_include_file: true}
      - sv/vip_chi_agent_pkg.sv:                  {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - "akerlund::vip_memory:2.0.1"
      - "akerlund::vip_gauss:1.0.0"

targets:
  default:
    filesets:
      - tb
