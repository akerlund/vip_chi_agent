CAPI=2:
name: "akerlund::vip_chi_agent:1.0.0"
description: "UVM CHI verification agent"

filesets:
  tb:
    files:

      # Compilation unit: entry point compiled directly by the simulator
      - sv/vip_chi.svh

      # Include files: accessed via +incdir+ (included by the .svh or the agent package)
      - sv/vip_chi_types_pkg.sv:                  {is_include_file: true}
      - sv/vip_chi_if.sv:                         {is_include_file: true}
      - sv/vip_chi_sva.sv:                        {is_include_file: true}
      - sv/vip_chi_snp_sva.sv:                    {is_include_file: true}
      - sv/vip_chi_cfg_agent.sv:                  {is_include_file: true}
      - sv/vip_chi_cfg_item.sv:                   {is_include_file: true}
      - sv/vip_chi_lcrd_mgr.sv:                   {is_include_file: true}
      - sv/vip_chi_item.sv:                       {is_include_file: true}
      - sv/vip_chi_sequencer.sv:                  {is_include_file: true}
      - sv/vip_chi_monitor.sv:                    {is_include_file: true}
      - sv/vip_chi_monitor_e.sv:                  {is_include_file: true}
      - sv/vip_chi_coverage.sv:                   {is_include_file: true}
      - sv/vip_chi_perf_counters.sv:              {is_include_file: true}
      - sv/vip_chi_hni_sam.sv:                    {is_include_file: true}
      - sv/vip_chi_scoreboard.sv:                 {is_include_file: true}
      - sv/vip_chi_coherency_checker.sv:          {is_include_file: true}
      - sv/vip_chi_driver_rni.sv:                 {is_include_file: true}
      - sv/vip_chi_issue_e_fields.sv:             {is_include_file: true}
      - sv/vip_chi_driver_rni_e.sv:               {is_include_file: true}
      - sv/vip_chi_driver_rnf.sv:                 {is_include_file: true}
      - sv/vip_chi_driver_rnf_e.sv:               {is_include_file: true}
      - sv/vip_chi_driver_snf.sv:                 {is_include_file: true}
      - sv/vip_chi_driver_snf_e.sv:               {is_include_file: true}
      - sv/vip_chi_driver_hni.sv:                 {is_include_file: true}
      - sv/vip_chi_driver_hnf.sv:                 {is_include_file: true}
      - sv/vip_chi_driver_hnf_e.sv:               {is_include_file: true}
      - sv/seq_lib/vip_chi_seq_config.sv:         {is_include_file: true}
      - sv/seq_lib/vip_chi_addr_iterator.sv:      {is_include_file: true}
      - sv/seq_lib/vip_chi_seq_payload_buffer.sv: {is_include_file: true}
      - sv/seq_lib/vip_chi_seq_counter_iter.sv:   {is_include_file: true}
      - sv/seq_lib/vip_chi_base_seq.sv:           {is_include_file: true}
      - sv/seq_lib/vip_chi_read_seq.sv:           {is_include_file: true}
      - sv/seq_lib/vip_chi_coherent_base_seq.sv:  {is_include_file: true}
      - sv/seq_lib/vip_chi_readshared_seq.sv:     {is_include_file: true}
      - sv/seq_lib/vip_chi_readclean_seq.sv:      {is_include_file: true}
      - sv/seq_lib/vip_chi_readunique_seq.sv:     {is_include_file: true}
      - sv/seq_lib/vip_chi_writeback_seq.sv:      {is_include_file: true}
      - sv/seq_lib/vip_chi_evict_seq.sv:          {is_include_file: true}
