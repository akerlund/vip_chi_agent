      - sv/seq_lib/vip_chi_makeunique_seq.sv:     {is_include_file: true}
      - sv/seq_lib/vip_chi_readonce_seq.sv:       {is_include_file: true}
      - sv/seq_lib/vip_chi_writeunique_seq.sv:    {is_include_file: true}
      - sv/seq_lib/vip_chi_excl_load_seq.sv:      {is_include_file: true}
      - sv/seq_lib/vip_chi_excl_store_seq.sv:     {is_include_file: true}
      - sv/seq_lib/vip_chi_write_seq.sv:          {is_include_file: true}
      - sv/seq_lib/vip_chi_write_zero_seq.sv:     {is_include_file: true}
      - sv/seq_lib/vip_chi_write_cmo_seq.sv:      {is_include_file: true}
